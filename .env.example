# Copy to .env and adjust. docker-compose.yml reads these.

# --- Reverse proxy / public address ---
# Local dev: leave as :80 (plain HTTP) and open http://localhost:8080
# Production (Oracle VM): set to your domain for automatic HTTPS, e.g.
#   SITE_ADDRESS=prolysis.duckdns.org
SITE_ADDRESS=:80

# Host port that Caddy's HTTP listener maps to (open http://localhost:${HTTP_PORT}).
HTTP_PORT=8080

# --- Database ---
# Compose uses fixed credentials internally (see docker-compose.yml). Override here only
# if you point at an external Postgres.
# DATABASE_URL=postgres://prolysis:prolysis@postgres:5432/prolysis
