{
  "name": "prolysis-bff",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Backend-for-frontend: GraphQL API over the Python backend and Postgres.",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "tsx src/server.ts",
    "typecheck": "tsc --noEmit",
    "codegen": "kysely-codegen --dialect postgres --out-file src/db-types.ts"
  },
  "dependencies": {
    "@pothos/core": "^4.3.0",
    "graphql": "^16.9.0",
    "graphql-yoga": "^5.10.4",
    "kysely": "^0.27.4",
    "pg": "^8.13.1",
    "tsx": "^4.19.2"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/pg": "^8.11.10",
    "kysely-codegen": "^0.17.0",
    "typescript": "^5.7.2"
  }
}
